@model IEnumerable<Tour>

@{
    ViewData["Title"] = "Tour - Voyager";
    var tours = Model?.ToList() ?? new List<Tour>();
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalTours = ViewData["TotalTours"] as int? ?? tours.Count;
    var query = ViewData["Query"] as string;
    var minPrice = ViewData["MinPrice"] as decimal?;
    var maxPrice = ViewData["MaxPrice"] as decimal?;
    var selectedRegions = ViewData["Regions"] as string[] ?? Array.Empty<string>();
    var maxPriceValue = maxPrice.HasValue ? (int)maxPrice.Value : 3500000;
    var minPriceValue = 500000;
    var maxRangeValue = 10000000;
    var vnd = CultureInfo.GetCultureInfo("vi-VN");

    string TruncateDescription(string? text, int maxLength = 120)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var normalized = text.Trim();
        normalized = System.Text.RegularExpressions.Regex.Replace(normalized, "(\\.\\s*){3,}|…", string.Empty);
        normalized = System.Text.RegularExpressions.Regex.Replace(normalized, "\\s{2,}", " ").Trim();

        if (normalized.Length <= maxLength)
        {
            return normalized;
        }

        var cut = normalized[..maxLength].TrimEnd();
        return cut + "...";
    }

    // GÁN ẢNH TĨNH TẠI ĐÂY (nếu bạn muốn):
    // Ví dụ: staticTourImage1 = "/images/tours/tour-1.jpg";
    string staticTourImage1 = "";
    string staticTourImage2 = "";
    string staticTourImage3 = "";
    string staticTourImage4 = "";
    string staticTourImage5 = "";
    string staticTourImage6 = "";

    var staticImages = new[] { staticTourImage1, staticTourImage2, staticTourImage3, staticTourImage4, staticTourImage5, staticTourImage6 };

    string NormalizeImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return string.Empty;
        }

        if (imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("~", StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("wwwroot/", StringComparison.OrdinalIgnoreCase))
        {
            return "/" + imageUrl.Substring("wwwroot/".Length).TrimStart('/');
        }

        if (imageUrl.StartsWith("/", StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl.Replace("\\", "/");
        }

        if (imageUrl.StartsWith("images/", StringComparison.OrdinalIgnoreCase))
        {
            return "/" + imageUrl.TrimStart('/');
        }

        return "/images/" + imageUrl.TrimStart('/');
    }
}

<link rel="stylesheet" href="~/css/tours.css" asp-append-version="true" />

<div class="tours-page">
    <div class="tours-shell">
        <aside class="filters-panel">
            <h3>☰ Bộ lọc</h3>
            <form method="get" asp-action="Index" class="filters-form">
                @if (!string.IsNullOrWhiteSpace(query))
                {
                    <input type="hidden" name="query" value="@query" />
                }
                @if (minPrice.HasValue)
                {
                    <input type="hidden" name="minPrice" value="@minPrice" />
                }

                <div class="filter-block">
                    <p class="filter-title">ĐỊA ĐIỂM</p>
                    <label>
                        <input type="checkbox" name="regions" value="Miền Bắc" @(selectedRegions.Contains("Miền Bắc") ? "checked" : "") />
                        Miền Bắc
                    </label>
                    <label>
                        <input type="checkbox" name="regions" value="Miền Trung" @(selectedRegions.Contains("Miền Trung") ? "checked" : "") />
                        Miền Trung
                    </label>
                    <label>
                        <input type="checkbox" name="regions" value="Miền Nam" @(selectedRegions.Contains("Miền Nam") ? "checked" : "") />
                        Miền Nam
                    </label>
                </div>

                <div class="filter-block">
                    <p class="filter-title">KHOẢNG GIÁ</p>
                    <input type="range" name="maxPrice" min="@minPriceValue" max="@maxRangeValue" step="100000" value="@maxPriceValue" id="maxPriceRange" />
                    <div class="range-values">
                        <span>@string.Format(vnd, "{0:C0}", minPriceValue)</span>
                        <span id="maxPriceValue">@string.Format(vnd, "{0:C0}", maxPriceValue)</span>
                    </div>
                </div>

                <div class="filter-block">
                    <p class="filter-title">THỜI LƯỢNG</p>
                    <div class="duration-chips">
                        <button type="button" class="chip active">3-5 ngày</button>
                        <button type="button" class="chip">1-2 tuần</button>
                        <button type="button" class="chip">1 tháng+</button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100">Áp dụng</button>
            </form>
        </aside>

        <section class="tours-content">
            @if (TempData["BookingMessage"] is string bookingMessage && !string.IsNullOrWhiteSpace(bookingMessage))
            {
                <div class="alert alert-warning">@bookingMessage</div>
            }
            <div class="tours-head">
                <div>
                    <h1>Hành trình chọn lọc</h1>
                    <p>Khám phá @totalTours trải nghiệm độc quyền dành cho bạn.</p>
                </div>
                <div class="sort-box">
                    <span>Sắp xếp theo:</span>
                    <strong>Đề xuất</strong>
                </div>
            </div>

            <div class="tours-grid">
                @if (tours.Any())
                {
                    @for (var i = 0; i < tours.Count; i++)
                    {
                        var item = tours[i];
                        var displayImage = !string.IsNullOrWhiteSpace(staticImages[i])
                            ? staticImages[i]
                            : item.ImageUrl;
                        displayImage = NormalizeImageUrl(displayImage);

                        <a class="tour-card-link" asp-action="Details" asp-route-id="@item.TourId">
                            <article class="tour-card">
                                <div class="tour-image">
                                    @if (!string.IsNullOrWhiteSpace(displayImage))
                                    {
                                        <img src="@Url.Content(displayImage)" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">Để trống ảnh - bạn gán sau trong biến staticTourImage@(i + 1)</div>
                                    }
                                </div>
                                <div class="tour-info">
                                    <h3><span class="tour-title">@item.Name</span><span>★ 4.8</span></h3>
                                    <p>@TruncateDescription(item.Description)</p>
                                    <div class="tour-price">
                                        <small>BẮT ĐẦU TỪ</small>
                                        <strong>@item.Price.ToString("C0", vnd)</strong>
                                        <span class="tour-cta">→</span>
                                    </div>
                                </div>
                            </article>
                        </a>
                    }
                }
                else
                {
                    <div class="no-results" style="padding:40px 24px; text-align:center;">
                        <h3>Không có tour phù hợp với bộ lọc</h3>
                        <p>Thử giảm khoảng giá hoặc liên hệ để biết thêm thông tin.</p>
                        <div style="margin-top:16px; display:flex; gap:12px; justify-content:center;">
                            <a class="btn-outline" href="@Url.Action("Index", "Tours")">Xóa bộ lọc</a>
                            <a class="btn-primary" href="@Url.Action("Contact", "Home")">Liên hệ để biết giá</a>
                        </div>
                    </div>
                }
            </div>

            <div class="pagination-ui">
                @{
                    var regionQuery = selectedRegions.Length > 0
                        ? string.Join("&", selectedRegions.Select(r => "regions=" + System.Uri.EscapeDataString(r)))
                        : string.Empty;

                    var prevUrl = Url.Action("Index", new { page = currentPage - 1, query, minPrice, maxPrice }) ?? string.Empty;
                    var nextUrl = Url.Action("Index", new { page = currentPage + 1, query, minPrice, maxPrice }) ?? string.Empty;

                    var prevLink = string.IsNullOrWhiteSpace(regionQuery) ? prevUrl : $"{prevUrl}&{regionQuery}";
                    var nextLink = string.IsNullOrWhiteSpace(regionQuery) ? nextUrl : $"{nextUrl}&{regionQuery}";
                }
                <a class="page-btn" href="@prevLink">‹</a>
                @for (var i = 1; i <= totalPages; i++)
                {
                    var pageUrl = Url.Action("Index", new { page = i, query, minPrice, maxPrice }) ?? string.Empty;
                    var pageLink = string.IsNullOrWhiteSpace(regionQuery) ? pageUrl : $"{pageUrl}&{regionQuery}";
                    <a class="page-btn @(i == currentPage ? "active" : "")" href="@pageLink">@i</a>
                }
                <a class="page-btn" href="@nextLink">›</a>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var range = document.getElementById("maxPriceRange");
            var label = document.getElementById("maxPriceValue");

            if (!range || !label) {
                return;
            }

            var formatter = new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND", maximumFractionDigits: 0 });

            var updateLabel = function () {
                var value = Number(range.value || 0);
                label.textContent = formatter.format(value);
            };

            range.addEventListener("input", updateLabel);
            updateLabel();
        })();
    </script>
}
