@model IEnumerable<Tour>

@{
    ViewData["Title"] = "Tour - Voyager";
    var tours = Model?.ToList() ?? new List<Tour>();
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalTours = ViewData["TotalTours"] as int? ?? tours.Count;
    var query = ViewData["Query"] as string;
    var minPrice = ViewData["MinPrice"] as decimal?;
    var maxPrice = ViewData["MaxPrice"] as decimal?;

    // GÁN ẢNH TĨNH TẠI ĐÂY (nếu bạn muốn):
    // Ví dụ: staticTourImage1 = "/images/tours/tour-1.jpg";
    string staticTourImage1 = "";
    string staticTourImage2 = "";
    string staticTourImage3 = "";
    string staticTourImage4 = "";
    string staticTourImage5 = "";
    string staticTourImage6 = "";

    var staticImages = new[] { staticTourImage1, staticTourImage2, staticTourImage3, staticTourImage4, staticTourImage5, staticTourImage6 };
}

<link rel="stylesheet" href="~/css/tours.css" asp-append-version="true" />

<div class="tours-page">
    <div class="tours-shell">
        <aside class="filters-panel">
            <h3>☰ Bộ lọc</h3>

            <div class="filter-block">
                <p class="filter-title">ĐỊA ĐIỂM</p>
                <label><input type="checkbox" checked /> Scandinavia</label>
                <label><input type="checkbox" /> Địa Trung Hải</label>
                <label><input type="checkbox" /> Đông Nam Á</label>
                <label><input type="checkbox" /> Nam Mỹ</label>
            </div>

            <div class="filter-block">
                <p class="filter-title">KHOẢNG GIÁ</p>
                <input type="range" min="500" max="10000" value="3500" />
                <div class="range-values">
                    <span>$500</span>
                    <span>$10,000</span>
                </div>
            </div>

            <div class="filter-block">
                <p class="filter-title">THỜI LƯỢNG</p>
                <div class="duration-chips">
                    <button type="button" class="chip active">3-5 ngày</button>
                    <button type="button" class="chip">1-2 tuần</button>
                    <button type="button" class="chip">1 tháng+</button>
                </div>
            </div>
        </aside>

        <section class="tours-content">
            <div class="tours-head">
                <div>
                    <h1>Hành trình chọn lọc</h1>
                    <p>Khám phá @totalTours trải nghiệm độc quyền dành cho bạn.</p>
                </div>
                <div class="sort-box">
                    <span>Sắp xếp theo:</span>
                    <strong>Đề xuất</strong>
                </div>
            </div>

            <div class="tours-grid">
                @if (tours.Any())
                {
                    @for (var i = 0; i < tours.Count; i++)
                    {
                        var item = tours[i];
                        var displayImage = !string.IsNullOrWhiteSpace(staticImages[i])
                            ? staticImages[i]
                            : item.ImageUrl;

                        <a class="tour-card-link" asp-action="Details" asp-route-id="@item.TourId">
                            <article class="tour-card">
                                <div class="tour-image">
                                    @if (!string.IsNullOrWhiteSpace(displayImage))
                                    {
                                        <img src="@displayImage" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">Để trống ảnh - bạn gán sau trong biến staticTourImage@(i + 1)</div>
                                    }
                                </div>
                                <div class="tour-info">
                                    <h3>@item.Name <span>★ 4.8</span></h3>
                                    <p>@item.Description</p>
                                    <div class="tour-price">
                                        <small>BẮT ĐẦU TỪ</small>
                                        <strong>$@item.Price</strong>
                                        <span class="tour-cta">→</span>
                                    </div>
                                </div>
                            </article>
                        </a>
                    }
                }
                else
                {
                    @for (var i = 0; i < 6; i++)
                    {
                        <a class="tour-card-link" asp-action="Details" asp-route-id="1">
                            <article class="tour-card">
                                <div class="tour-image">
                                    <div class="image-placeholder">Để trống ảnh - bạn gán sau trong biến staticTourImage@(i + 1)</div>
                                </div>
                                <div class="tour-info">
                                    <h3>Tên tour @(i + 1) <span>★ 0.0</span></h3>
                                    <p>Mô tả tour sẽ hiển thị tại đây.</p>
                                    <div class="tour-price">
                                        <small>BẮT ĐẦU TỪ</small>
                                        <strong>$0</strong>
                                        <span class="tour-cta">→</span>
                                    </div>
                                </div>
                            </article>
                        </a>
                    }
                }
            </div>

            <div class="pagination-ui">
                <a class="page-btn" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-query="@query" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice">‹</a>
                @for (var i = 1; i <= totalPages; i++)
                {
                    <a class="page-btn @(i == currentPage ? "active" : "")" asp-action="Index" asp-route-page="@i" asp-route-query="@query" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice">@i</a>
                }
                <a class="page-btn" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-query="@query" asp-route-minPrice="@minPrice" asp-route-maxPrice="@maxPrice">›</a>
            </div>
        </section>
    </div>
</div>
