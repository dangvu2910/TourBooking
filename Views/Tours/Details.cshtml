@model Tour

@{
    ViewData["Title"] = "Chi tiet tour";
    var heroImage = !string.IsNullOrWhiteSpace(Model?.ImageUrl)
        ? Model.ImageUrl
        : "https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1600&q=80";
    var price = Model?.Price ?? 0;
}

<link rel="stylesheet" href="~/css/tour-details.css" asp-append-version="true" />

<div class="tour-details">
    <section class="tour-hero" style="background-image: url('@heroImage');">
        <div class="tour-hero-overlay">
            <div class="tour-hero-content">
                <span class="tour-badge">HANH TRINH DAC SAC</span>
                <h1>@Model?.Name</h1>
                <div class="tour-meta">
                    <span>📍 @Model?.Location</span>
                    <span>•</span>
                    <span>4 ngay 3 dem</span>
                </div>
            </div>
            <div class="tour-price-card">
                <span>BAT DAU TU</span>
                <strong>$@price.ToString("N0")</strong>
                <small>/ nguoi</small>
            </div>
        </div>
    </section>

    <section class="tour-content">
        <div class="tour-left">
            <div class="tour-section">
                <h2>Gioi thieu ve tour</h2>
                <p>@(string.IsNullOrWhiteSpace(Model?.Description) ? "Chua co mo ta chi tiet. Vui long lien he de biet them thong tin." : Model.Description)</p>
                <div class="tour-tags">
                    <span>Wellness</span>
                    <span>Light Hike</span>
                    <span>Half Board</span>
                    <span>4+ Stay</span>
                </div>
            </div>

            <div class="tour-section">
                <h3>Hanh trinh cua ban</h3>
                <div class="tour-journey">
                    <div class="journey-step">
                        <div class="step-index">01</div>
                        <div>
                            <h4>Den noi va nghi ngoi</h4>
                            <p>Don tai san bay va di chuyen ve khu nghi duong. Thuong thuc bua toi va nghi ngoai.</p>
                        </div>
                    </div>
                    <div class="journey-step">
                        <div class="step-index">02</div>
                        <div>
                            <h4>Kham pha dia danh noi bat</h4>
                            <p>Tron ven ngay tham quan voi huong dan vien dia phuong va thoi gian tu do.</p>
                        </div>
                    </div>
                    <div class="journey-step">
                        <div class="step-index">03</div>
                        <div>
                            <h4>Thuong thuc van hoa ban dia</h4>
                            <p>Giai nghiem am thuc va trai nghiem dia phuong doc dao.</p>
                        </div>
                    </div>
                    <div class="journey-step">
                        <div class="step-index">04</div>
                        <div>
                            <h4>Ket thuc hanh trinh</h4>
                            <p>Tu do mua sam va tra phong. Tien doan ra san bay.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <aside class="tour-right">
            <div class="tour-booking">
                <h3>Chon ngay khoi hanh</h3>
                <div class="booking-field">
                    <span>Ngay di</span>
                    <div class="booking-input">24/10/2024</div>
                </div>
                <div class="booking-field">
                    <span>So khach</span>
                    <div class="booking-input">2 nguoi</div>
                </div>
                <div class="booking-total">
                    <span>Tong gia</span>
                    <strong>$@((price * 2).ToString("N0"))</strong>
                </div>
                <a class="book-button" asp-controller="Home" asp-action="Booking" asp-route-tourId="@Model?.TourId">Dat ngay</a>
                <p class="booking-note">Xac nhan nhanh, khong phi phat sinh.</p>
            </div>

            <div class="tour-guarantees">
                <div class="guarantee-item">🛡️ Dat tour an toan</div>
                <div class="guarantee-item">✅ Hoan huy linh hoat</div>
            </div>
        </aside>
    </section>
</div>
