@model Tourbooking.ViewModels.HomePageViewModel

@{
    ViewData["Title"] = "Trang chủ - Voyager";
    var vnd = CultureInfo.GetCultureInfo("vi-VN");
    var fallbackImage = "/images/8c18b822-a807-48e3-b471-ef035840c58c_mientay.jpeg";
    var heroSlides = Model?.HeroTours ?? new List<Tour>();
    var dealsToday = Model?.DealsToday ?? new List<Tour>();
    var monthlyDeals = Model?.MonthlyDeals ?? new List<Tour>();
    var promoBanners = Model?.PromoBanners ?? new List<Tourbooking.ViewModels.HomePromoBanner>();
    var topChoices = Model?.TopChoices ?? new List<Tour>();

    string GetDiscount(int index) => index switch
    {
        0 => "-20%",
        1 => "-15%",
        2 => "-10%",
        _ => "-8%"
    };

    string GetHeroTag(int index) => index switch
    {
        0 => "Tour uy tín hàng đầu",
        1 => "Ưu đãi hè rực rỡ",
        _ => "Săn cờ giờ vàng"
    };

    string NormalizeImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return fallbackImage;
        }

        if (imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) || imageUrl.StartsWith("/"))
        {
            return imageUrl;
        }

        return $"/images/{imageUrl}";
    }
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="home-page">
    <section class="hero-slider" aria-label="Tour nổi bật">
        <div class="hero-slider-track">
            @for (var i = 0; i < heroSlides.Count; i++)
            {
                var slide = heroSlides[i];
                var heroImage = NormalizeImageUrl(slide.ImageUrl);
                <article class="hero-slide @(i == 0 ? "is-active" : "")" style="background-image: url('@heroImage');">
                    <div class="hero-overlay"></div>
                    <div class="home-container hero-content">
                        <span class="hero-tag">@GetHeroTag(i)</span>
                        <h1>@slide.Name</h1>
                        <p class="hero-price">Giá chỉ từ: <strong>@slide.Price.ToString("C0", vnd)</strong></p>
                        <p class="hero-desc">@slide.Description</p>
                        <div class="hero-actions">
                            <a class="btn-hero primary" asp-controller="Tours" asp-action="Details" asp-route-id="@slide.TourId">Đặt ngay →</a>
                            <a class="btn-hero ghost" href="/Home/Booking">Liên hệ tư vấn</a>
                        </div>
                    </div>
                </article>
            }
        </div>
        <button class="hero-nav is-prev" type="button" aria-label="Trước">‹</button>
        <button class="hero-nav is-next" type="button" aria-label="Sau">›</button>
        <div class="hero-dots" role="tablist" aria-label="Chọn slide">
            @for (var i = 0; i < heroSlides.Count; i++)
            {
                <button class="hero-dot @(i == 0 ? "is-active" : "")" type="button" aria-label="Slide @(i + 1)"></button>
            }
        </div>
        <div class="hero-search">
            <form class="search-bar" asp-controller="Tours" asp-action="Index" method="get">
                <input type="text" name="query" placeholder="Tìm kiếm tour, địa điểm..." />
                <input type="number" name="guests" placeholder="Số người" min="1" step="1" />
                <input type="number" name="maxPrice" placeholder="Giá tối đa" min="0" step="100" />
                <button type="submit">Tìm kiếm</button>
            </form>
        </div>
    </section>

    <section class="deal-section">
        <div class="home-container">
            <div class="section-header">
                <div>
                    <p class="label">GỢI Ý CHO BẠN</p>
                    <h2>Ưu đãi hôm nay</h2>
                </div>
                <a asp-controller="Tours" asp-action="Index" class="view-all-link">Xem thêm →</a>
            </div>
            <div class="deal-grid">
                @for (var i = 0; i < dealsToday.Count; i++)
                {
                    var deal = dealsToday[i];
                    var dealImage = NormalizeImageUrl(deal.ImageUrl);
                    <article class="deal-card">
                        <a class="deal-image" asp-controller="Tours" asp-action="Details" asp-route-id="@deal.TourId">
                            <img src="@dealImage" alt="@deal.Name" />
                            <span class="deal-badge">@GetDiscount(i)</span>
                        </a>
                        <div class="deal-content">
                            <h3>@deal.Name</h3>
                            <p class="deal-location">@deal.Location</p>
                            <div class="deal-meta">
                                <span class="price">@deal.Price.ToString("C0", vnd)</span>
                                <a class="deal-link" asp-controller="Tours" asp-action="Details" asp-route-id="@deal.TourId">Đặt tour →</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="deal-section alt">
        <div class="home-container">
            <div class="section-header">
                <div>
                    <p class="label">ƯU ĐÃI THÁNG</p>
                    <h2>Chọn tour hot trong tháng</h2>
                </div>
            </div>
            <div class="deal-grid">
                @for (var i = 0; i < monthlyDeals.Count; i++)
                {
                    var deal = monthlyDeals[i];
                    var dealImage = NormalizeImageUrl(deal.ImageUrl);
                    <article class="deal-card compact">
                        <a class="deal-image" asp-controller="Tours" asp-action="Details" asp-route-id="@deal.TourId">
                            <img src="@dealImage" alt="@deal.Name" />
                            <span class="deal-badge">@GetDiscount(i)</span>
                        </a>
                        <div class="deal-content">
                            <h3>@deal.Name</h3>
                            <p class="deal-location">@deal.Location</p>
                            <div class="deal-meta">
                                <span class="price">@deal.Price.ToString("C0", vnd)</span>
                                <a class="deal-link" asp-controller="Tours" asp-action="Details" asp-route-id="@deal.TourId">Xem chi tiết →</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="promo-section">
        <div class="home-container">
            <div class="section-header">
                <div>
                    <p class="label">KHUYẾN MÃI</p>
                    <h2>Deal tốt - đặt sớm</h2>
                </div>
            </div>
            <div class="promo-grid">
                @foreach (var promo in promoBanners)
                {
                    var promoImage = NormalizeImageUrl(promo.ImageUrl);
                    <article class="promo-card" style="background-image: url('@promoImage');">
                        <div class="promo-overlay"></div>
                        <div class="promo-content">
                            <h3>@promo.Title</h3>
                            <p>@promo.Description</p>
                            @if (promo.TourId.HasValue)
                            {
                                <a class="btn-hero ghost" asp-controller="Tours" asp-action="Details" asp-route-id="@promo.TourId">@promo.Cta →</a>
                            }
                            else
                            {
                                <a class="btn-hero ghost" asp-controller="Tours" asp-action="Index">@promo.Cta →</a>
                            }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="top-choice-section">
        <div class="home-container">
            <div class="section-header">
                <div>
                    <p class="label">TOP LỰA CHỌN THÁNG</p>
                    <h2>Được nhiều khách yêu thích</h2>
                </div>
                <a asp-controller="Tours" asp-action="Index" class="view-all-link">Khám phá thêm →</a>
            </div>
            <div class="top-choice-grid">
                @foreach (var choice in topChoices)
                {
                    var choiceImage = NormalizeImageUrl(choice.ImageUrl);
                    <article class="top-choice-card">
                        <a class="top-choice-image" asp-controller="Tours" asp-action="Details" asp-route-id="@choice.TourId">
                            <img src="@choiceImage" alt="@choice.Name" />
                        </a>
                        <div class="top-choice-content">
                            <h3>@choice.Name</h3>
                            <p>@choice.Location</p>
                            <div class="top-choice-meta">
                                <span class="price">@choice.Price.ToString("C0", vnd)</span>
                                <span class="rating">⭐ 4.8</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var slider = document.querySelector(".hero-slider");
            if (!slider) {
                return;
            }

            var slides = Array.from(slider.querySelectorAll(".hero-slide"));
            var dots = Array.from(slider.querySelectorAll(".hero-dot"));
            var prev = slider.querySelector(".hero-nav.is-prev");
            var next = slider.querySelector(".hero-nav.is-next");
            var current = 0;
            var timerId;

            var setActive = function (index) {
                slides.forEach(function (slide, idx) {
                    slide.classList.toggle("is-active", idx === index);
                });
                dots.forEach(function (dot, idx) {
                    dot.classList.toggle("is-active", idx === index);
                });
                current = index;
            };

            var step = function (dir) {
                var nextIndex = (current + dir + slides.length) % slides.length;
                setActive(nextIndex);
            };

            var restartTimer = function () {
                if (timerId) {
                    window.clearInterval(timerId);
                }
                timerId = window.setInterval(function () {
                    step(1);
                }, 6000);
            };

            prev.addEventListener("click", function () {
                step(-1);
                restartTimer();
            });

            next.addEventListener("click", function () {
                step(1);
                restartTimer();
            });

            dots.forEach(function (dot, idx) {
                dot.addEventListener("click", function () {
                    setActive(idx);
                    restartTimer();
                });
            });

            restartTimer();
        })();
    </script>
}
