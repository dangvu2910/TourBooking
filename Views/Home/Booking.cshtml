@model Tourbooking.ViewModels.BookingCreateViewModel

@{
    ViewData["Title"] = "Đặt chỗ - Voyager";
    var heroImage = !string.IsNullOrWhiteSpace(Model?.TourImageUrl)
        ? Model.TourImageUrl
        : "https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1200&q=80";
    var price = Model?.TourPrice ?? 0;
    var guestCount = Model?.GuestCount ?? 1;
    var vnd = CultureInfo.GetCultureInfo("vi-VN");
    var serviceFee = Model?.ServiceFee ?? 0;
    var localTax = Model?.LocalTax ?? 0;
    var total = (price * guestCount) + serviceFee + localTax;
}

<link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />

<div class="booking-page">
    <section class="booking-hero">
        <div class="booking-hero-label">THANH TOÁN AN TOÀN</div>
        <h1>Hoàn tất hành trình của bạn.</h1>
        <p>Vui lòng điền thông tin bên dưới để xác nhận chuyến đi của bạn.</p>
        <p>Cuộc phiêu lưu bắt đầu chỉ với một lần nhấn.</p>
    </section>

    <section class="booking-grid">
        <div class="booking-left">
            <form asp-action="Booking" method="post" class="booking-card" id="bookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TourId" />
                <input type="hidden" asp-for="PaymentMethod" />
                <div class="card-title">
                    <span class="card-icon">◎</span>
                    <div>
                        <h2>Thông tin khách</h2>
                        <p>Nhập thông tin liên hệ và ngày khởi hành mong muốn.</p>
                    </div>
                </div>

                <div class="form-grid">
                    <label>
                        <span>Họ và tên</span>
                        <input asp-for="FullName" type="text" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Email</span>
                        <input asp-for="Email" type="email" placeholder="ban@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Số điện thoại</span>
                        <input asp-for="PhoneNumber" type="tel" placeholder="+84 900 000 000" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Ngày khởi hành</span>
                        <input asp-for="TravelDate" type="date" />
                        <span asp-validation-for="TravelDate" class="text-danger"></span>
                    </label>
                </div>

                <div class="people-row">
                    <p>Số lượng khách</p>
                    <div class="people-chips">
                        <input asp-for="GuestCount" type="number" min="1" max="20" />
                        <span asp-validation-for="GuestCount" class="text-danger"></span>
                    </div>
                </div>

                <div class="payment-card">
                    <h3>Phương thức thanh toán</h3>
                    <div class="payment-options">
                        <button type="button" class="payment-option active" data-method="Card">
                            <span class="payment-icon">▭</span>
                            Thẻ tín dụng
                        </button>
                        <button type="button" class="payment-option" data-method="BankTransfer">
                            <span class="payment-icon">🏦</span>
                            Chuyển khoản
                        </button>
                    </div>

                    <div class="payment-details bank-transfer-fields" data-method="BankTransfer">
                        <div class="payment-detail-title">Thông tin chuyển khoản</div>
                        <div class="bank-qr">
                            <div class="bank-qr-header">
                                <span>Quét QR BIDV</span>
                                <span id="bankTransferAmount" class="bank-qr-amount"></span>
                            </div>
                            <img id="bankQrImage"
                                 src="~/images/qrthanhtoan.jpg"
                                 alt="QR chuyển khoản BIDV"
                                 data-bank-code="BIDV"
                                 data-account-number="6330966460"
                                 data-account-name="BUI DANG VU"
                                 data-add-info-template="thanh toan tour {TourId}" />
                               <p class="bank-qr-note">Quét QR để thanh toán chuyển khoản.</p>
                        </div>
                        <input type="hidden" asp-for="BankName" />
                        <input type="hidden" asp-for="BankAccountName" />
                        <input type="hidden" asp-for="BankAccountNumber" />
                        <input type="hidden" asp-for="BankReference" />
                        <p class="payment-note">Giao dịch chuyển khoản sẽ ở trạng thái chờ xác nhận.</p>
                    </div>
                </div>
            </form>
        </div>

        <aside class="booking-right">
            <div class="summary-card">
                <div class="summary-image">
                    <img src="@heroImage" alt="@Model?.TourName" />
                </div>
                <div class="summary-body">
                    <div class="summary-title">
                        <div>
                            <h3>@Model?.TourName</h3>
                            <p>📍 @Model?.TourLocation</p>
                        </div>
                        <span class="summary-rating">★ 4.9</span>
                    </div>

                    <div class="summary-line">
                        <span>Giá cơ bản</span>
                        <strong id="basePrice" data-price="@price">@price.ToString("C0", vnd)</strong>
                    </div>
                    <div class="summary-line">
                        <span>Phí dịch vụ</span>
                        <strong id="serviceFee" data-fee="@serviceFee">@serviceFee.ToString("C0", vnd)</strong>
                    </div>
                    <div class="summary-line">
                        <span>Thuế địa phương</span>
                        <strong id="localTax" data-tax="@localTax">@localTax.ToString("C0", vnd)</strong>
                    </div>

                    <div class="summary-total">
                        <span>Tổng thanh toán</span>
                        <strong id="totalPrice">@total.ToString("C0", vnd)</strong>
                    </div>

                    <button class="confirm-button" type="submit" form="bookingForm">Xác nhận đặt chuyến</button>
                    <p class="summary-note">Giao dịch được hỗ trợ bởi MoMo và chuyển khoản</p>
                </div>
            </div>

            <div class="trust-row">
                <div class="trust-item">🔒 100% thanh toán an toàn</div>
                <div class="trust-item">🎧 Hỗ trợ chuyên gia 24/7</div>
            </div>
        </aside>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var guestInput = document.querySelector("input[name='GuestCount']");
            var basePrice = document.getElementById("basePrice");
            var serviceFee = document.getElementById("serviceFee");
            var localTax = document.getElementById("localTax");
            var totalPrice = document.getElementById("totalPrice");
            var paymentOptions = document.querySelectorAll(".payment-option");
            var paymentMethodInput = document.querySelector("input[name='PaymentMethod']");
            var bankTransferFields = document.querySelector(".bank-transfer-fields");
            var bankQrImage = document.getElementById("bankQrImage");
            var bankTransferAmount = document.getElementById("bankTransferAmount");
            var bankReferenceInput = document.querySelector("input[name='BankReference']");
            var bankNameInput = document.querySelector("input[name='BankName']");
            var bankAccountNameInput = document.querySelector("input[name='BankAccountName']");
            var bankAccountNumberInput = document.querySelector("input[name='BankAccountNumber']");
            var tourIdInput = document.querySelector("input[name='TourId']");
            var emailInput = document.querySelector("input[name='Email']");

            if (!guestInput || !basePrice || !serviceFee || !localTax || !totalPrice) {
                return;
            }

            var priceValue = Number(basePrice.getAttribute("data-price")) || 0;
            var serviceValue = Number(serviceFee.getAttribute("data-fee")) || 0;
            var taxValue = Number(localTax.getAttribute("data-tax")) || 0;
            var formatter = new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND", maximumFractionDigits: 0 });

            var updateTotal = function () {
                var count = Number(guestInput.value || 1);
                if (count < 1) {
                    count = 1;
                    guestInput.value = "1";
                }

                var total = (priceValue * count) + serviceValue + taxValue;
                totalPrice.textContent = formatter.format(total);
                updateBankTransferDetails(total);
            };

            var buildAddInfo = function () {
                if (!bankQrImage) {
                    return "";
                }

                var template = bankQrImage.getAttribute("data-add-info-template") || "";
                var tourId = tourIdInput ? tourIdInput.value : "";
                var email = emailInput ? emailInput.value : "";
                return template
                    .replace("{TourId}", tourId)
                    .replace("{Email}", email);
            };

            var updateBankTransferDetails = function (total) {
                var amount = Math.max(0, Math.round(Number(total) || 0));
                if (bankTransferAmount) {
                    bankTransferAmount.textContent = formatter.format(amount);
                }

                var addInfo = buildAddInfo();
                if (bankReferenceInput && !bankReferenceInput.value && addInfo) {
                    bankReferenceInput.value = addInfo;
                }

                if (bankQrImage) {
                    var bankCode = bankQrImage.getAttribute("data-bank-code") || "";
                    var accountNumber = bankQrImage.getAttribute("data-account-number") || "";
                    var accountName = bankQrImage.getAttribute("data-account-name") || "";
                    if (bankNameInput) {
                        bankNameInput.value = bankCode;
                    }

                    if (bankAccountNameInput) {
                        bankAccountNameInput.value = accountName;
                    }

                    if (bankAccountNumberInput) {
                        bankAccountNumberInput.value = accountNumber;
                    }
                    if (bankCode && accountNumber) {
                        var qrUrl = "https://api.vietqr.io/image/" + bankCode + "-" + accountNumber + "-compact2.png?amount=" + amount;
                        if (addInfo) {
                            qrUrl += "&addInfo=" + encodeURIComponent(addInfo);
                        }
                        if (accountName) {
                            qrUrl += "&accountName=" + encodeURIComponent(accountName);
                        }
                        bankQrImage.setAttribute("src", qrUrl);
                    }
                }
            };

            guestInput.addEventListener("input", updateTotal);
            guestInput.addEventListener("change", updateTotal);
            updateTotal();

            var updatePaymentView = function (method) {
                var normalized = method === "BankTransfer" ? "BankTransfer" : "Card";
                if (paymentMethodInput) {
                    paymentMethodInput.value = normalized;
                }

                paymentOptions.forEach(function (option) {
                    var isActive = option.getAttribute("data-method") === normalized;
                    option.classList.toggle("active", isActive);
                });

                if (bankTransferFields) {
                    var showTransfer = normalized === "BankTransfer";
                    bankTransferFields.classList.toggle("is-active", showTransfer);
                }
            };

            paymentOptions.forEach(function (option) {
                option.addEventListener("click", function () {
                    updatePaymentView(option.getAttribute("data-method"));
                });
            });

            updatePaymentView(paymentMethodInput ? paymentMethodInput.value : "Card");
        })();
    </script>
}
