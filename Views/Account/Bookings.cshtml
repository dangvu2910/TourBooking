@model Tourbooking.ViewModels.AccountBookingsViewModel

@{
    ViewData["Title"] = "Quản lý đặt chỗ";
    var vnd = CultureInfo.GetCultureInfo("vi-VN");
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/account-bookings.css" asp-append-version="true" />

<div class="profile-page">
    <div class="profile-shell">
        <aside class="profile-sidebar">
            <h2>Cài đặt</h2>
            <p class="profile-subtitle">Quản lý trải nghiệm du lịch của bạn</p>

            <nav class="profile-nav">
                <a class="profile-link" asp-action="Profile">Thông tin cá nhân</a>
                <a class="profile-link" asp-action="ChangePassword">Đổi mật khẩu</a>
                <a class="profile-link active" asp-action="Bookings">Quản lý đặt chỗ</a>
                <button class="profile-link" type="button">Thông báo</button>
                <button class="profile-link" type="button">Thanh toán</button>
            </nav>

            <form asp-controller="Account" asp-action="Logout" method="post" class="profile-logout">
                @Html.AntiForgeryToken()
                <button type="submit">Đăng xuất</button>
            </form>
        </aside>

        <section class="profile-main">
            <div class="profile-card">
                <div class="bookings-header">
                    <div>
                        <h3>Quản lý đặt chỗ</h3>
                        <p>Kiểm tra các tour bạn đã đặt và trạng thái hiện tại.</p>
                        @if (TempData["BookingSuccess"] is string bookingSuccess)
                        {
                            <p class="text-success mt-2">@bookingSuccess</p>
                        }
                    </div>
                    <div class="bookings-tabs">
                        <span class="bookings-tab active">Tất cả (@Model.TotalBookings)</span>
                        <span class="bookings-tab">Sắp tới (@Model.UpcomingBookings)</span>
                        <span class="bookings-tab">Đã hoàn thành (@Model.CompletedBookings)</span>
                        <span class="bookings-tab">Đã hủy (@Model.CancelledBookings)</span>
                    </div>
                </div>

                <div class="booking-list">
                    @if (Model.Bookings.Any())
                    {
                        foreach (var booking in Model.Bookings)
                        {
                            var statusClass = booking.Status.ToLowerInvariant();
                            var statusLabel = booking.Status switch
                            {
                                "Confirmed" => "Đã xác nhận",
                                "Cancelled" => "Đã hủy",
                                _ => "Chờ xác nhận"
                            };

                            <article class="booking-item">
                                <div class="booking-thumb">
                                    @if (!string.IsNullOrWhiteSpace(booking.ImageUrl))
                                    {
                                        <img src="@booking.ImageUrl" alt="@booking.TourName" />
                                    }
                                    else
                                    {
                                        <span>Chưa có ảnh</span>
                                    }
                                </div>
                                <div class="booking-info">
                                    <h4>@booking.TourName</h4>
                                    <p>📍 @booking.TourLocation</p>
                                    <div class="booking-meta">
                                        <span>Mã: VOY-@booking.BookingId</span>
                                        <span>Ngày đi: @booking.TravelDate.ToString("dd/MM/yyyy")</span>
                                        <span>@booking.GuestCount người</span>
                                    </div>
                                </div>
                                <div class="booking-price">
                                    <span>Tổng thanh toán</span>
                                    <strong>@booking.TotalPrice.ToString("C0", vnd)</strong>
                                    <span class="status-pill @statusClass">@statusLabel</span>
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <p>Bạn chưa có đặt chỗ nào. Hãy khám phá tour mới ngay!</p>
                    }
                </div>
            </div>
        </section>
    </div>
</div>
