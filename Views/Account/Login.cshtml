@model Tourbooking.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập - Tourbooking";
    Layout = "_LayoutLogin";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <div class="login-content">
        <!-- Left Side: Background -->
        <div class="login-side login-left">
            <div class="login-overlay">
                <h1>Voyager</h1>
                <p>Gợi ý hành trình của bạn qua những phong cảnh đầy chất thơ trên thế giới.</p>
                
                <div class="inspiration">
                    <p class="quote">"Du lịch là thứ duy nhất bạn mua mà làm bạn giàu lên."</p>
                    <div class="author-info">
                        <img src="https://via.placeholder.com/40" alt="Tác giả" class="author-avatar">
                        <span>Elena S, Trưởng bộ phận tour</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="login-side login-right">
            <div class="login-form-wrapper">
                <h2>Chào mừng quay lại</h2>
                <p class="subtitle">Vui lòng nhập thông tin để truy cập tài khoản.</p>

                <form asp-action="Login" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Email Input -->
                    <div class="form-group">
                                <label for="email">Địa chỉ email</label>
                                    <input asp-for="Email" class="form-control" placeholder="ví dụ: traveler@voyager.com" />
                           <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="form-group">
                        <div class="password-header">
                            <label for="password">Mật khẩu</label>
                            <a href="#" class="forgot-password">Quên mật khẩu?</a>
                        </div>
                        <div class="password-input-group">
                            <input asp-for="Password" class="form-control" placeholder="••••••••" type="password" />
                            <button type="button" class="password-toggle-btn" tabindex="-1">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Remember Me -->
                    <div class="form-group checkbox-group">
                        <input asp-for="RememberMe" />
                        <label asp-for="RememberMe">Ghi nhớ đăng nhập trong 30 ngày</label>
                    </div>

                    <!-- Sign In Button -->
                    <button type="submit" class="btn-signin">Đăng nhập Voyager</button>

                    <!-- Divider -->
                    <div class="divider">Hoặc tiếp tục với</div>

                    <!-- Social Login -->
                    <div class="social-login">
                        <a href="#" class="social-btn google-btn">
                            <img src="https://www.google.com/favicon.ico" alt="Google">
                            Google
                        </a>
                        <a href="#" class="social-btn apple-btn">
                            <img src="https://www.apple.com/favicon.ico" alt="Apple">
                            Apple
                        </a>
                    </div>

                    <!-- Sign Up Link -->
                    <p class="signup-link">
                        Chưa có tài khoản? <a asp-action="Register" asp-controller="Account">Đăng ký</a>
                    </p>
                </form>

                <!-- Footer -->
                <div class="login-footer">
                    <p>© 2024 Voyager. Bảo lưu mọi quyền.</p>
                    <div class="footer-links">
                        <a href="#">Chính sách bảo mật</a>
                        <span>•</span>
                        <a href="#">Điều khoản</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.password-toggle-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const input = this.closest('.password-input-group').querySelector('input');
            if (input.type === 'password') {
                input.type = 'text';
                this.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                    </svg>
                `;
            } else {
                input.type = 'password';
                this.innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>
                `;
            }
        });
    });
</script>
