@{
    ViewData["Title"] = "Thong tin ca nhan";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-page">
    <div class="profile-shell">
        <aside class="profile-sidebar">
            <h2>Cai dat</h2>
            <p class="profile-subtitle">Quan ly trai nghiem du lich cua ban</p>

            <nav class="profile-nav">
                <button class="profile-link active" type="button">Thong tin ca nhan</button>
                <button class="profile-link" type="button">Doi mat khau</button>
                <button class="profile-link" type="button">Thong bao</button>
                <button class="profile-link" type="button">Thanh toan</button>
            </nav>

            <form asp-controller="Account" asp-action="Logout" method="post" class="profile-logout">
                @Html.AntiForgeryToken()
                <button type="submit">Dang xuat</button>
            </form>
        </aside>

        <section class="profile-main">
            <div class="profile-card">
                <div class="profile-header">
                    <div class="profile-avatar">
                        <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=200&q=80" alt="Anh dai dien" />
                    </div>
                    <div>
                        <h3>Thong tin ca nhan</h3>
                        <p>Cap nhat thong tin de Voyager phuc vu ban tot hon.</p>
                    </div>
                    <div class="profile-actions">
                        <button class="btn-outline" type="button">Huy</button>
                        <button class="btn-primary" type="button">Luu thay doi</button>
                    </div>
                </div>

                <div class="profile-form">
                    <label>
                        <span>Ho va ten</span>
                        <input type="text" value="Nguyen Van A" />
                    </label>
                    <label>
                        <span>Email lien he</span>
                        <input type="email" value="nguyen.vana@voyager.vn" />
                    </label>
                    <label>
                        <span>So dien thoai</span>
                        <input type="text" value="+84 901 234 567" />
                    </label>
                    <label>
                        <span>Dia chi</span>
                        <input type="text" value="Thao Dien, Quan 2, TP. Ho Chi Minh" />
                    </label>
                </div>

                <div class="profile-preferences">
                    <div>
                        <h4>Uu tien trai nghiem</h4>
                        <p>Chon cac loai hinh du lich yeu thich de ca nhan hoa hanh trinh.</p>
                    </div>
                    <div class="profile-tags">
                        <button type="button" class="tag active">Nghi duong</button>
                        <button type="button" class="tag">Kham pha</button>
                        <button type="button" class="tag active">Am thuc</button>
                        <button type="button" class="tag">Van hoa</button>
                    </div>
                </div>
            </div>

            <div class="profile-card profile-alert">
                <div class="alert-icon">🔒</div>
                <div>
                    <h4>Xac thuc hai yeu to (2FA)</h4>
                    <p>Tang cuong bao mat cho tai khoan Voyager cua ban.</p>
                </div>
                <button class="btn-link" type="button">Thiet lap ngay</button>
            </div>
        </section>
    </div>
</div>
