@{
    var pageTitle = ViewData["Title"] as string ?? "Quản trị";
    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    var currentAction = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    var searchQuery = ViewData["SearchQuery"] as string ?? string.Empty;
    var searchPlaceholder = ViewData["SearchPlaceholder"] as string ?? "Tìm kiếm";
    var notifications = ViewData["Notifications"] as List<AdminNotificationItem> ?? new List<AdminNotificationItem>();
    var notificationCount = ViewData["NotificationCount"] as int? ?? notifications.Count;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Quản trị Voyager</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="brand-block brand-link" asp-controller="Home" asp-action="Index">
                <span class="brand-title">Quản trị Voyager</span>
                <span class="brand-subtitle">Trung tâm điều phối</span>
            </a>

            <nav class="admin-nav">
                <a class="nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "is-active" : "")" href="/Admin/Dashboard">Bảng điều khiển</a>
                <a class="nav-link @(currentController == "Admin" && currentAction == "Tours" ? "is-active" : "")" href="/Admin/Tours">Tour</a>
                <a class="nav-link @(currentController == "Admin" && currentAction == "Bookings" ? "is-active" : "")" href="/Admin/Bookings">Đặt chỗ</a>
                <a class="nav-link @(currentController == "Admin" && currentAction == "Reviews" ? "is-active" : "")" href="/Admin/Reviews">Đánh giá</a>
                <a class="nav-link @(currentController == "Admin" && currentAction == "Contacts" ? "is-active" : "")" href="/Admin/Contacts">Liên hệ</a>
                <a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "is-active" : "")" href="/Admin/Users">Người dùng</a>
            </nav>

            <div class="admin-footer-links">
                <a href="#">Cài đặt</a>
                <a href="#">Hỗ trợ</a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-header">
                <form method="get" asp-controller="@currentController" asp-action="@currentAction" class="search-wrap">
                    <input type="text" name="query" value="@searchQuery" placeholder="@searchPlaceholder" />
                </form>
                <div class="admin-actions">
                    <details class="notification-menu">
                        <summary class="ghost-action notification-trigger">
                            <span class="notification-icon">🔔</span>
                            <span>Thông báo</span>
                            @if (notificationCount > 0)
                            {
                                <span class="notification-badge">@notificationCount</span>
                            }
                        </summary>
                        <div class="notification-panel">
                            <div class="notification-header">
                                <strong>Thông báo</strong>
                                <span>@notificationCount</span>
                            </div>
                            <div class="notification-list">
                                @if (notifications.Count == 0)
                                {
                                    <div class="notification-empty">Chưa có thông báo mới.</div>
                                }
                                else
                                {
                                    foreach (var item in notifications)
                                    {
                                        <div class="notification-item">
                                            <div class="notification-dot"></div>
                                            <div>
                                                <div class="notification-title">@item.Title</div>
                                                <div class="notification-desc">@item.Description</div>
                                                <div class="notification-time">@item.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </details>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="admin-logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ghost-action">Đăng xuất</button>
                    </form>
                    <div class="admin-avatar">AR</div>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="detail-modal" class="detail-modal" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="detail-card">
            <div class="detail-header">
                <h3 class="detail-title">Chi tiết</h3>
                <button type="button" class="ghost-action detail-close" data-close>Đóng</button>
            </div>
            <div class="detail-body"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (() => {
            const modal = document.getElementById('detail-modal');
            if (!modal) {
                return;
            }

            const titleEl = modal.querySelector('.detail-title');
            const bodyEl = modal.querySelector('.detail-body');
            const closeButtons = modal.querySelectorAll('[data-close]');
            const endpoints = {
                tour: '/Admin/TourDetail',
                booking: '/Admin/BookingDetail',
                review: '/Admin/ReviewDetail',
                user: '/Admin/UserDetail'
            };

            const openModal = () => {
                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
            };

            const closeModal = () => {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
            };

            const renderLines = (container, value) => {
                const lines = (value ?? '').toString().split('\n');
                lines.forEach((line) => {
                    const lineEl = document.createElement('div');
                    lineEl.className = 'detail-line';
                    lineEl.textContent = line;
                    container.appendChild(lineEl);
                });
            };

            const renderField = (label, value) => {
                const row = document.createElement('div');
                row.className = 'detail-row';

                const labelEl = document.createElement('div');
                labelEl.className = 'detail-label';
                labelEl.textContent = label || '';

                const valueEl = document.createElement('div');
                valueEl.className = 'detail-value';
                const safeValue = value ?? '-';
                if (safeValue.toString().includes('\n')) {
                    valueEl.classList.add('is-long');
                    renderLines(valueEl, safeValue);
                } else {
                    valueEl.textContent = safeValue.toString();
                }

                row.appendChild(labelEl);
                row.appendChild(valueEl);
                bodyEl.appendChild(row);
            };

            closeButtons.forEach((btn) => btn.addEventListener('click', closeModal));
            modal.addEventListener('click', (event) => {
                if (event.target === modal) {
                    closeModal();
                }
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                    closeModal();
                }
            });

            document.addEventListener('click', async (event) => {
                const trigger = event.target.closest('.detail-trigger');
                if (!trigger) {
                    return;
                }

                event.preventDefault();
                const entity = trigger.dataset.entity;
                const id = trigger.dataset.id;
                const endpoint = endpoints[entity];
                if (!endpoint || !id) {
                    return;
                }

                openModal();
                titleEl.textContent = 'Đang tải...';
                bodyEl.innerHTML = '<div class="detail-loading">Đang tải thông tin...</div>';

                try {
                    const response = await fetch(`${endpoint}?id=${encodeURIComponent(id)}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) {
                        throw new Error('Request failed');
                    }

                    const data = await response.json();
                    titleEl.textContent = data.title || 'Chi tiết';
                    bodyEl.innerHTML = '';
                    (data.fields || []).forEach((field) => renderField(field.label, field.value));
                } catch (error) {
                    titleEl.textContent = 'Không tải được';
                    bodyEl.innerHTML = '<div class="detail-error">Không thể lấy dữ liệu chi tiết.</div>';
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
