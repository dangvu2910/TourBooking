<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tourbooking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Tourbooking.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container">
                <div class="navbar-content">
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Voyager</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                        <ul class="navbar-nav navbar-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                            {
                                <a class="nav-link text-dark" href="/Admin/Tours">Tours</a>
                            }
                            else
                            {
                                <a class="nav-link text-dark" asp-area="" asp-controller="Tours" asp-action="Index">Tours</a>
                            }
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Dashboard">Admin</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Booking">Booking</a>
                        </li>
                    </ul>
                        <div class="d-flex gap-2 align-items-center navbar-auth">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <span class="small text-muted">@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-primary btn-sm">Sign Out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm" href="/Account/Login">Sign In</a>
                            <a class="btn btn-primary btn-sm" href="/Account/Register">Sign Up</a>
                        }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-5 mt-5">
        <div class="container">
            <div class="row mb-4">
                <div class="col-md-3">
                    <h5>Voyager</h5>
                    <p class="small text-muted">Redefining modern travel through curated experiences and seamless bookings.</p>
                </div>
                <div class="col-md-3">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled small">
                        <li><a href="/Tours" class="text-decoration-none text-muted">Destinations</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Itineraries</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Travel Guides</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Company</h5>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-decoration-none text-muted">About Us</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Privacy Policy</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Newsletter</h5>
                    <p class="small text-muted">Get the latest travel inspiration in your inbox.</p>
                    <div class="input-group input-group-sm">
                        <input type="email" class="form-control" placeholder="Email address">
                        <button class="btn btn-primary" type="button">→</button>
                    </div>
                </div>
            </div>
            <div class="border-top border-secondary pt-3 text-center small text-muted">
                © 2026 The Ethereal Voyager. All rights reserved. | 
                <a href="#" class="text-decoration-none text-muted">TERMS</a> | 
                <a href="#" class="text-decoration-none text-muted">COOKIES</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
