@model Tourbooking.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "_AdminLayout";
    var vnd = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="dashboard-hero">
    <div>
        <h1>Tổng quan bảng điều khiển</h1>
        <p>Chào mừng quay lại. Đây là những gì đang diễn ra trên hệ sinh thái du lịch hôm nay.</p>
    </div>
    <div class="status-chip">Đang hoạt động</div>
</section>

<section class="stat-grid">
    <article class="stat-card">
        <div class="stat-icon">TO</div>
        <div>
            <p>Tổng số tour</p>
            <h2>@Model.TotalTours</h2>
        </div>
        <span class="stat-badge">Doanh thu: @Model.TotalRevenue</span>
    </article>
    <article class="stat-card">
        <div class="stat-icon">BK</div>
        <div>
            <p>Tổng số đặt chỗ</p>
            <h2>@Model.TotalBookings</h2>
        </div>
        <span class="stat-badge">@Model.ConfirmedBookings đã xác nhận</span>
    </article>
    <article class="stat-card">
        <div class="stat-icon">US</div>
        <div>
            <p>Tổng số người dùng</p>
            <h2>@Model.TotalUsers</h2>
        </div>
        <span class="stat-badge">Mới 30 ngày: @Model.NewUsersLast30Days</span>
    </article>
</section>

<section class="dashboard-grid">
    <article class="panel-card">
        <div class="panel-header">
            <div>
                <h3>Xu hướng đặt chỗ</h3>
                <p>Tổng quan theo tháng về số đặt chỗ</p>
            </div>
            <div class="segmented">
                <button class="is-active" type="button">Theo tháng</button>
            </div>
        </div>
        <div class="chart-wrap">
            @{
                var maxCount = Model.BookingTrends.Count == 0
                    ? 0
                    : Model.BookingTrends.Max(t => t.Count);
            }
            @if (Model.BookingTrends.Count == 0)
            {
                <div class="empty-state">Chưa có dữ liệu đặt chỗ để hiển thị</div>
            }
            else
            {
                foreach (var point in Model.BookingTrends)
                {
                    var height = maxCount == 0 ? 0 : (int)Math.Round(point.Count * 100d / maxCount);
                    <div class="bar @(point.Count == maxCount && maxCount > 0 ? "is-peak" : "")" style="height: @(height)%">
                        <span>@point.Label</span>
                    </div>
                }
            }
        </div>
    </article>

    <article class="panel-card">
        <div class="panel-header">
            <div>
                <h3>Hoạt động gần đây</h3>
                <p>Cảnh báo và sự kiện mới nhất</p>
            </div>
        </div>
        <div class="activity-list">
            @foreach (var activity in Model.RecentActivities)
            {
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div>
                        <strong>@activity.Title</strong>
                        <span>@activity.Description</span>
                    </div>
                </div>
            }
        </div>
    </article>
</section>

<section class="panel-card top-tours">
    <div class="panel-header">
        <div>
            <h3>Tour hiệu quả nhất</h3>
            <p>Những tour có hiệu suất và độ quan tâm cao</p>
        </div>
        <a class="panel-link" asp-controller="Admin" asp-action="Tours">Quản lý tất cả</a>
    </div>

    <div class="tour-cards">
        @if (Model.TopTours.Any())
        {
            foreach (var tour in Model.TopTours)
            {
                <article class="tour-card">
                    <div class="tour-image">
                        @if (!string.IsNullOrWhiteSpace(tour.ImageUrl))
                        {
                            <img src="@Url.Content(tour.ImageUrl)" alt="@tour.Name" />
                        }
                        else
                        {
                            <div class="tour-placeholder"></div>
                        }
                    </div>
                    <div class="tour-body">
                        <h4>@tour.Name</h4>
                        <p>@tour.Location</p>
                        <span>@tour.Metric</span>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="tour-card">
                <div class="tour-image">
                    <div class="tour-placeholder"></div>
                </div>
                <div class="tour-body">
                    <h4>Tour mẫu</h4>
                    <p>Đang chờ dữ liệu</p>
                    <span>@string.Format(vnd, "{0:C0}", 0)</span>
                </div>
            </article>
        }
    </div>
</section>
