@model Tourbooking.ViewModels.AdminBookingsViewModel

@{
    ViewData["Title"] = "Đặt chỗ";
    Layout = "_AdminBookingsLayout";
}

<section class="bookings-hero">
    <div>
        <h1>Quản lý đặt chỗ</h1>
        <p>Rà soát và quản lý các đặt chỗ tour gần đây.</p>
    </div>
    <button class="primary-action" type="button">Xuất CSV</button>
</section>

<section class="stat-grid">
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">BK</div>
            Tổng số đặt chỗ
        </div>
        <div class="stat-value">@Model.TotalBookings</div>
        <div class="stat-meta">+12% trong tháng</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">RV</div>
            Doanh thu
        </div>
        <div class="stat-value">@Model.Revenue</div>
        <div class="stat-meta">+8% so với tháng trước</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">AT</div>
            Tour đang hoạt động
        </div>
        <div class="stat-value">@Model.ActiveTours</div>
        <div class="stat-meta">Trên 14 quốc gia</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">AG</div>
            Quy mô nhóm TB
        </div>
        <div class="stat-value">@Model.AverageGroupSize</div>
        <div class="stat-meta">Cá nhân hóa hành trình</div>
    </article>
</section>

<section class="panel-card">
    <div class="panel-header">
        <div>
                <h3>Đặt chỗ gần đây</h3>
                <p>Hoạt động mới nhất trong quy trình đặt chỗ</p>
        </div>
        <div class="table-actions">
                <button type="button">Lọc</button>
                <button type="button">Sắp xếp</button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Tên tour</th>
                    <th>Ngày</th>
                    <th>Số lượng</th>
                    <th>Tổng giá</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.RecentBookings)
                {
                    <tr>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">@booking.CustomerInitials</div>
                                <div class="user-meta">
                                    <strong>@booking.CustomerName</strong>
                                    <span>@booking.CustomerEmail</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="table-title">@booking.TourName</div>
                        </td>
                        <td>@booking.Date</td>
                        <td>@booking.Quantity</td>
                        <td class="table-strong">@booking.TotalPrice</td>
                        <td>
                            <span class="status-pill @booking.Status.ToLower()">@booking.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
