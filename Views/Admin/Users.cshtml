@model Tourbooking.ViewModels.AdminUsersViewModel

@{
    ViewData["Title"] = "Người dùng";
    Layout = "_AdminLayout";
}

<section class="dashboard-hero">
    <div>
        <p class="eyebrow">Hệ thống quản trị</p>
        <h1>Quản lý người dùng</h1>
    </div>
    <div class="hero-actions">
        <button type="button" class="ghost-action">Xuất báo cáo</button>
        <button type="button" class="primary-action">Thêm người dùng mới</button>
    </div>
</section>

<section class="panel-card">
    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Ngày gia nhập</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">@user.Initials</div>
                                <div class="user-meta">
                                    <strong>@user.Name</strong>
                                </div>
                            </div>
                        </td>
                        <td class="table-muted">@user.Email</td>
                        <td>
                            @{ var roleLabel = user.Role == "Admin" ? "Quản trị" : "Người dùng"; }
                            <span class="role-pill @(user.Role == "Admin" ? "admin" : "user")">@roleLabel</span>
                        </td>
                        <td>@user.JoinedDate</td>
                        <td>
                            @{ var statusLabel = user.Status == "Active" ? "Đang hoạt động" : "Tạm dừng"; }
                            <span class="status-text @(user.Status == "Active" ? "active" : "paused")">@statusLabel</span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button type="button" class="icon-button">✎</button>
                                <button type="button" class="icon-button">⋯</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span>Hiển thị 1-@Model.Users.Count của @Model.TotalUsers người dùng</span>
        <div class="pager">
            <button type="button">1</button>
            <button type="button" class="is-active">2</button>
            <button type="button">3</button>
        </div>
    </div>
</section>
